# ============================================
# DeepCareer 环境配置文件
# 复制此文件为 .env 并填入实际值
# ============================================

# ---------- OpenAI 配置（可选）----------
# 用于 LLM 智能提取简历信息，不配置则使用规则提取
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# ---------- 模力方舟 Embedding / Rerank 配置 ----------
# 不把令牌写入代码；可直接复用 OPENAI_API_KEY，也可单独设置此变量
MAGIC_ARK_API_KEY=
MAGIC_ARK_BASE_URL=https://us.picpi.top
MAGIC_ARK_EMBEDDING_MODEL=bge-m3
MAGIC_ARK_RERANK_MODEL=bge-reranker-v2-m3
MAGIC_ARK_TIMEOUT=60
MAGIC_ARK_MAX_RETRIES=2
# Embedding 服务不可用时是否阻止简历保存；默认 false，保留规则/AI解析结果
REQUIRE_EMBEDDING=false
# 本机 PostgreSQL 未安装 pgvector 时设为 false，向量将以 JSONB 保存
USE_PGVECTOR=true

# ---------- 数据库配置（必填）----------
# USE_PGVECTOR=true 时，PostgreSQL 需要安装 pgvector 扩展
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=deepcareer
POSTGRES_USER=deepcareer_user
POSTGRES_PASSWORD=your_password_here

# 数据库连接池配置
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Redis 配置（可选）----------
# 用于缓存，不配置也可运行
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 缓存过期时间（秒）
CACHE_EXPIRE_TIME=3600

# ---------- 应用配置 ----------
# 服务端口
APP_HOST=0.0.0.0
APP_PORT=8001

# 调试模式（生产环境设为 false）
DEBUG=true

# 跨域配置（前端地址）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 文件上传配置
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# ---------- 日志配置 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/deepcareer.log

# ---------- 爬虫配置 ----------
# BOSS直聘 Cookie（从浏览器复制）
# 获取方法：登录 zhipin.com -> F12 -> Network -> 复制 Cookie
BOSS_COOKIE=

# ---------- 向量搜索配置 ----------
# 向量维度（bge-m3 = 1024维）
EMBEDDING_DIMENSION=1024

# 向量搜索结果数量
VECTOR_SEARCH_LIMIT=50
RERANK_CANDIDATE_LIMIT=50

# ---------- 匹配算法配置 ----------
# 5维度权重（总和应为1.0）
WEIGHT_POSITION=0.30
WEIGHT_SKILLS=0.25
WEIGHT_EXPERIENCE=0.20
WEIGHT_EDUCATION=0.15
WEIGHT_SEMANTIC=0.10

# 匹配阈值（0-100）
MATCH_THRESHOLD=60
